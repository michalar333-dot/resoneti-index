rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['companyName', 'answers', 'createdAt'])
        && data.companyName is string
        && data.companyName.size() <= 200
        && data.createdAt == request.time;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'prkpartnersmarketing@gmail.com' || request.auth.token.email == 'karin.strakova@gmail.com');
    }

    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId);
      allow list: if isOwner();
      allow create: if isValidId(submissionId) && isValidSubmission(incoming());
      allow update, delete: if false;
    }
  }
}
